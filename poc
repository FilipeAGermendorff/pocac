powershell.exe -WindowStyle Hidden -Command "$b=(Get-CimInstance Win32_BIOS).SerialNumber -replace '\s',''; $c=(Get-CimInstance Win32_Processor).ProcessorId -replace '\s',''; $m=(Get-CimInstance Win32_BaseBoard).SerialNumber -replace '\s',''; $d=(Get-CimInstance Win32_DiskDrive | Where-Object {$_.Index -eq 0}).SerialNumber -replace '[\s.]',''; $n=(Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1).MacAddress; $h=($b,$c,$m,$d,$n) -join '-'; Set-Content -Path 'hwid.dat' -Value $h -NoNewline -Encoding ASCII"
